# ImageKit URL endpoint, from https://imagekit.io dashboard > Developer Options > API Keys.
# Safe to expose: Vite inlines VITE_* vars into the client bundle, so never put
# the ImageKit private key here.
VITE_URL_IK_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Base URL of the backend API, no trailing slash.
# Local default is http://localhost:3000 when unset.
VITE_API_URL=http://localhost:3000
