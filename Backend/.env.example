# MongoDB connection string.
# Local:  mongodb://localhost:27017/pinterest
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pinterest
MONGO=

# Secret used to sign auth JWTs. Use a long random string.
# Generate one with: openssl rand -base64 32
JWT_SECRET=

# ImageKit credentials, from https://imagekit.io dashboard > Developer Options > API Keys
IK_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IK_PUBLIC_KEY=
IK_PRIVATE_KEY=

# Origin allowed by CORS. Must be the exact deployed frontend URL, no trailing slash.
CLIENT_URL=http://localhost:5173

# Set to "production" when deployed. This switches the auth cookie to
# SameSite=None; Secure, which cross-site login requires. Leave unset locally.
NODE_ENV=

# PORT is injected by most hosts (Render, Railway, Koyeb) — do not set it there.
# Defaults to 3000 locally.
